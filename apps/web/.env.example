# 브라우저가 부르는 주소. 빌드 시점에 값이 박힙니다.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 서버 컴포넌트(공유 링크 미리보기)가 부르는 주소. 런타임에 읽습니다.
# 안 넣으면 NEXT_PUBLIC_API_BASE 를 씁니다.
API_BASE=http://localhost:8000

# ── 좌측 관리자 레일 ──
# 안 넣거나 1 이면 기본 켜짐. 출시할 때 0 을 넣으면 기본 꺼짐이 되고
# 그때부터는 ?admin=1 을 아는 사람만 봅니다.
# 빌드 시점에 값이 박히므로 바꾸면 재배포해야 합니다.
NEXT_PUBLIC_ADMIN_DEFAULT=1
