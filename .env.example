# API 서버 환경변수. 실제 값은 .env 에 넣고 커밋하지 마세요.

# 없으면 DB 없이 돌아갑니다 (statement_log 는 var/statement_log.jsonl 로 폴백)
DATABASE_URL=postgresql+psycopg2://sajudang:sajudang@localhost:5432/sajudang

# 없으면 프로세스 메모리 캐시로 폴백합니다. 운영에서는 반드시 설정하세요.
REDIS_URL=redis://localhost:6379/0

# 없거나 두 짝이 안 맞으면 결제를 거절합니다(503). 성공한 척하지 않습니다.
#
# ★ 반드시 "API 개별 연동 키" 를 쓰세요 — ck / sk 입니다.
#   프론트가 v2 SDK 의 payment()(결제창)를 부릅니다.
#   결제위젯 키(gck / gsk)를 넣으면 결제창은 뜨는데 승인에서 막힙니다.
#   손님이 카드를 긁은 뒤에 말입니다. 그래서 서버가 뜰 때 미리 거릅니다.
#
# ★ 라이브 시크릿 키를 이 파일이나 저장소 안 어디에도 적지 마세요.
#   여기는 구글 드라이브입니다 — 적는 순간 동기화됩니다.
#   운영:  fly secrets set -a sajudang-api TOSS_CLIENT_KEY=... TOSS_SECRET_KEY=...
#
#   test_ck_… / test_sk_…   개발
#   live_ck_… / live_sk_…   운영 — 실제로 돈이 오갑니다
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# statement_log 파일 폴백 경로 (DATABASE_URL 이 없을 때만 씀)
# STATEMENT_LOG_PATH=C:\dev\sajudang\var\statement_log.jsonl

# 브라우저가 이 API 를 부를 수 있는 출처. 쉼표로 여러 개.
# 배포 도메인을 빠뜨리면 화면이 조용히 빕니다.
CORS_ORIGINS=http://localhost:3000
